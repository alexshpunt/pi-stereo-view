{
  "name": "pi-agent-transcript",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Separate Pi conversation and activity without replacing native rendering.",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "^24.0.4",
    "pi-coding-agent-test": "0.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
