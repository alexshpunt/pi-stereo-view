{
  "name": "pi-agent-transcript",
  "version": "0.1.0",
  "type": "module",
  "description": "Keep Pi conversation separate from tool output and agent activity.",
  "license": "MIT",
  "author": "Alexander Shpuntenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexshpunt/pi-agent-transcript.git"
  },
  "homepage": "https://github.com/alexshpunt/pi-agent-transcript#readme",
  "bugs": {
    "url": "https://github.com/alexshpunt/pi-agent-transcript/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "transcript",
    "tui",
    "split-pane"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "profile": "vitest run --config vitest.profile.config.ts",
    "check": "npm run typecheck && npm test",
    "check:package": "vitest run test/package.integration.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "^24.0.4",
    "pi-coding-agent-test": "0.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
